function updateScoreboard(p: player):
    clearScoreboard({_p})
    set title of fastboard of {_p} to "&cAmongMC"


    if {game.state} is "waiting":

        if {config.taskBarMode} is 0:
            set {_taskbar} to getTr("config.taskbar.off")
        else if {config.taskBarMode} is 1:
            set {_taskbar} to getTr("config.taskbar.meetingsSB")
        else:
            set {_taskbar} to getTr("config.taskbar.always")

        if {config.anonymousVotes} is true:
            set {_votes} to getTr("config.yes")
        else:
            set {_votes} to getTr("config.no")

        if {config.confirmEjects} is true:
            set {_confirm} to getTr("config.yes")
        else:
            set {_confirm} to getTr("config.no")

        if {config.impostorsKnowEachOther} is true:
            set {_know} to getTr("config.yes")
        else:
            set {_know} to getTr("config.no")

        if {config.dynamicTasks} is true:
            set {_dtasks} to getTr("config.yes")
        else:
            set {_dtasks} to getTr("config.no")

        set line 2 of fastboard of {_p} to getTr("scoreboard.settings")

        set line 3 of fastboard of {_p} to getTr("scoreboard.impostors", "%{config.impostors}%")
        set line 4 of fastboard of {_p} to getTr("scoreboard.tasks", "%{config.tasksPerPlayer}%")
        set line 5 of fastboard of {_p} to getTr("scoreboard.speed", "%{config.playerSpeed}%")
        set line 6 of fastboard of {_p} to getTr("scoreboard.taskbar", "%{_taskbar}%")
        set line 7 of fastboard of {_p} to getTr("scoreboard.meetings", "%{config.meetingLimit}%")

        set line 8 of fastboard of {_p} to getTr("scoreboard.killCooldown", "%{config.killCooldown}%")
        set line 9 of fastboard of {_p} to getTr("scoreboard.killRange", "%{config.killRange}%")

        set line 10 of fastboard of {_p} to getTr("scoreboard.sabotageCooldown", "%{config.sabotageCooldown}%")

        set line 11 of fastboard of {_p} to getTr("scoreboard.anonymousVotes", "%{_votes}%")
        set line 12 of fastboard of {_p} to getTr("scoreboard.confirmEjects", "%{_confirm}%")
        set line 13 of fastboard of {_p} to getTr("scoreboard.impostorsKnowEachOther", "%{_know}%")
        set line 14 of fastboard of {_p} to getTr("scoreboard.dynamicTasks", "%{_dtasks}%")


    else:
        
        # RESUMO GLOBAL
        

        
        if {config.taskBarMode} is 2:
            set {doneGlobal} to {game.completedTasks}
        else if {config.taskBarMode} is 1:
            if {game.state} is "meeting":
                set {doneGlobal} to {game.completedTasks}
        if {game.completedTasks} is not set:
            set {doneGlobal} to 0

        set {_totalGlobal} to {game.totalTasks}

        if {doneGlobal} is not set:
            set {doneGlobal} to 0

        if {_totalGlobal} is not set:
            set {_totalGlobal} to 0
        
        if {config.taskBarMode} is not 0:
            set line 1 of fastboard of {_p} to getTr("scoreboard.completedTasks", "%{doneGlobal}%", "%{_totalGlobal}%")

       

        if {game.impostors::*} contains {_p}:

            set {_cd} to {killCooldown.%uuid of {_p}%}

            if {_cd} is not set:
                set {_cd} to 0

            if {_cd} < 1:
                set {_cd} to "Pronto!"

            set line 2 of fastboard of {_p} to getTr("scoreboard.killCooldownRemaining", "%{_cd}%")

        else:

            set {_donePlayer} to size of {playerTasksDone.%uuid of {_p}%::*}
            set {_totalPlayer} to {_donePlayer} + size of {playerTasks.%uuid of {_p}%::*}

            set line 2 of fastboard of {_p} to getTr("scoreboard.yourTasks", "%{_donePlayer}%", "%{_totalPlayer}%")

        set line 3 of fastboard of {_p} to ""

        
        # SABOTAGENS
        

        if {sabotage.lights.active} is true:

            set line 4 of fastboard of {_p} to getTr("scoreboard.lights1")
            set line 5 of fastboard of {_p} to getTr("scoreboard.lights2")
            set line 6 of fastboard of {_p} to getTr("scoreboard.lights3")

            stop

        else if {sabotage.reactor.active} is true:

            set line 4 of fastboard of {_p} to getTr("scoreboard.reactor1")
            set line 5 of fastboard of {_p} to getTr("scoreboard.reactor2")
            set line 6 of fastboard of {_p} to getTr("scoreboard.reactor3")
            set line 7 of fastboard of {_p} to getTr("scoreboard.timeRemaining", "%{sabotage.reactor.remaining}%")
            stop

        else if {sabotage.lab_fire.active} is true:

            set line 4 of fastboard of {_p} to getTr("scoreboard.labFire1")
            set line 5 of fastboard of {_p} to getTr("scoreboard.labFire2")
            set line 6 of fastboard of {_p} to getTr("scoreboard.labFire3")
            set line 7 of fastboard of {_p} to getTr("scoreboard.timeRemaining", "%{sabotage.lab_fire.remaining}%")

            stop

        set {_line} to 4

        
        # CREWMATES
        
        
        # LISTA DE TASKS
        

        if {_p} is not in {game.impostors::*}:

            # TASKS PENDENTES
            loop {playerTasks.%uuid of {_p}%::*}:

                set {_id} to loop-value

                set {_name} to getTr("taskname.%{_id}%")
                if {_name} is not set:
                    set {_name} to "%{_id}%"

                set {_total} to {task.%{_id}%.steps}
                if {_total} is not set:
                    set {_total} to 1

                if {_total} > 1:

                    if {task.%{_id}%.ordered} is true:

                        set {_done} to {playerTaskStep.%uuid of {_p}%.%{_id}%} - 1
                        if {_done} < 0:
                            set {_done} to 0

                    else:

                        set {_done} to {playerTaskProgress.%uuid of {_p}%.%{_id}%}
                        if {_done} is not set:
                            set {_done} to 0

                    set line {_line} of fastboard of {_p} to "&e- %{_name}% &7(%{_done}%/%{_total}%)"

                else:
                    set line {_line} of fastboard of {_p} to "&e- %{_name}%"

                add 1 to {_line}

                if {_line} > 15:
                    stop

            # TASKS CONCLUÍDAS
            loop {playerTasksDone.%uuid of {_p}%::*}:
                set {_id} to loop-value

                set {_name} to getTr("taskname.%{_id}%")
                if {_name} is not set:
                    set {_name} to "%{_id}%"

                set line {_line} of fastboard of {_p} to "&a✔ %{_name}%"

                add 1 to {_line}
                if {_line} > 15:
                    stop

        
        # IMPOSTORES
        

        else:
            
            if size of {game.impostors::*} = 1:
                set line {_line} of fastboard of {_p} to getTr("scoreboard.alone")

            else:
                
                if {config.impostorsKnowEachOther} is true:
                    set line {_line} of fastboard of {_p} to getTr("scoreboard.otherImpostors")
                    add 1 to {_line}

                    loop {game.impostors::*}:

                        if loop-value is {_p}:
                            continue

                        set line {_line} of fastboard of {_p} to "&c- %name of loop-value%"

                        add 1 to {_line}

                        if {_line} > 15:
                            stop
                else:
                    set line {_line} of fastboard of {_p} to getTr("scoreboard.dontKnow1")
                    add 1 to {_line}
                    set line {_line} of fastboard of {_p} to getTr("scoreboard.dontKnow2")


function clearScoreboard(p: player):
    clear fastboard of {_p}
