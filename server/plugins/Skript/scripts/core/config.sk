command /config:
    permission: op
    trigger:
        openConfig(player)

on load:
    if {config.playerSpeed} is not set:
        set {config.playerSpeed} to 1.0
        
    if {config.impostors} is not set:
        set {config.impostors} to 1

    if {config.tasksPerPlayer} is not set:
        set {config.tasksPerPlayer} to 10

    if {config.meetingLimit} is not set:
        set {config.meetingLimit} to 1

    if {config.doorCooldown} is not set:
        set {config.doorCooldown} to 30

    if {config.sabotageCooldown} is not set:
        set {config.sabotageCooldown} to 60

    if {config.initialSabotageCooldown} is not set:
        set {config.initialSabotageCooldown} to 15

    if {config.postMeetingSabotageCooldown} is not set:
        set {config.postMeetingSabotageCooldown} to 15

    if {config.initialMeetingCooldown} is not set:
        set {config.initialMeetingCooldown} to 15

    if {config.postMeetingCooldown} is not set:
        set {config.postMeetingCooldown} to 30

    if {config.anonymousVotes} is not set:
        set {config.anonymousVotes} to false

    if {config.confirmEjects} is not set:
        set {config.confirmEjects} to true

    if {config.initialKillCooldown} is not set:
        set {config.initialKillCooldown} to 10

    if {config.killCooldown} is not set:
        set {config.killCooldown} to 30

    if {config.postMeetingKillCooldown} is not set:
        set {config.postMeetingKillCooldown} to 10

    if {config.impostorsKnowEachOther} is not set:
        set {config.impostorsKnowEachOther} to true

    if {config.reactorCollapseTime} is not set:
        set {config.reactorCollapseTime} to 45

    if {config.labFireTime} is not set:
        set {config.labFireTime} to 45

    if {config.doorDuration} is not set:
        set {config.doorDuration} to 10

    if {config.killRange} is not set:
        set {config.killRange} to 2.5

function openConfig(p: player):

    set {_inv} to chest inventory with 6 rows named "&6Configuração do Jogo"

    set slot 0 of {_inv} to red concrete named "&cImpostores: %{config.impostors}%"

    set slot 9 of {_inv} to paper named "&eTasks por jogador: %{config.tasksPerPlayer}%"

    set slot 18 of {_inv} to feather named "&bVelocidade: %{config.playerSpeed}%x"

    set slot 24 of {_inv} to bell named "&6Reuniões por jogador: %{config.meetingLimit}%"
    

    if {config.taskBarMode} is 0:
        set {_mode} to "&cOFF"
    else if {config.taskBarMode} is 1:
        set {_mode} to "&eApenas reuniões"
    else:
        set {_mode} to "&aSempre"

    set slot 8 of {_inv} to compass named "&bTaskBar: %{_mode}%"
    

    if {config.anonymousVotes} is true:
        set {_votes} to "&aLigado"
    else:
        set {_votes} to "&cDesligado"

    set slot 17 of {_inv} to writable book named "&fVotos anônimos: %{_votes}%"
    

    if {config.confirmEjects} is true:
        set {_confirm} to "&aSim"
    else:
        set {_confirm} to "&cNão"

    set slot 26 of {_inv} to player head named "&fRevelar impostor ao ejetar: %{_confirm}%"

    if {config.impostorsKnowEachOther} is true:
        set {_know} to "&aSim"
    else:
        set {_know} to "&cNão"

    set slot 35 of {_inv} to red dye named "&cImpostores se conhecem: %{_know}%"



    set slot 4 of {_inv} to iron door named "&7Cooldown portas: %{config.doorCooldown}%s"

    set slot 13 of {_inv} to redstone named "&cCooldown sabotagens: %{config.sabotageCooldown}%s"

    set slot 22 of {_inv} to clock named "&eCooldown inicial de sabotagem: %{config.initialSabotageCooldown}%s"

    set slot 31 of {_inv} to repeater named "&6Cooldown após reunião: %{config.postMeetingSabotageCooldown}%s"

    set slot 48 of {_inv} to respawn anchor named "&4Colapso do reator: %{config.reactorCollapseTime}%s"

    set slot 49 of {_inv} to campfire named "&6Tempo do incêndio: %{config.labFireTime}%s"

    set slot 50 of {_inv} to iron bars named "&7Duração das portas: %{config.doorDuration}%s"



    set slot 6 of {_inv} to note block named "&bCooldown inicial de reunião: %{config.initialMeetingCooldown}%s"

    set slot 15 of {_inv} to lectern named "&9Cooldown de reunião: %{config.postMeetingCooldown}%s"

    
    

    set slot 53 of {_inv} to lime wool named "&a&lCOMEÇAR JOGO"

    

    set slot 2 of {_inv} to iron sword named "&cKill CD inicial: %{config.initialKillCooldown}%s"

    set slot 11 of {_inv} to diamond sword named "&cKill CD após matar: %{config.killCooldown}%s"

    set slot 20 of {_inv} to netherite sword named "&cKill CD após reunião: %{config.postMeetingKillCooldown}%s"

    set slot 29 of {_inv} to iron axe named "&cAlcance de kill: %{config.killRange}% blocos"

    

    loop 54 times:

        if slot (loop-number - 1) of {_inv} is air:
            continue

        set lore of slot (loop-number - 1) of {_inv} to "", "&7Clique esquerdo: aumentar", "&7Clique direito: diminuir"



    set lore of slot 8 of {_inv} to "", "&7Clique para alternar"

    set lore of slot 17 of {_inv} to "", "&7Clique para alternar"

    set lore of slot 26 of {_inv} to "", "&7Clique para alternar"

    set lore of slot 35 of {_inv} to "", "&7Clique para alternar"

    set lore of slot 53 of {_inv} to "", "&aIniciar a partida"

    open {_inv} to {_p}

    loop all players:
        updateScoreboard(loop-player)


on inventory click:

    if holder of event-inventory is set:
        stop

    if name of event-inventory is not "&6Configuração do Jogo":
        stop

    cancel event


    
    if clicked slot is 0:

        if click type is left mouse button:
            add 1 to {config.impostors}
        else if click type is right mouse button:
            remove 1 from {config.impostors}

        if {config.impostors} < 1:
            set {config.impostors} to 1
        if {config.impostors} > 3:
            set {config.impostors} to 3

        openConfig(player)
        stop


    
    if clicked slot is 9:

        if click type is left mouse button:
            add 1 to {config.tasksPerPlayer}
        else if click type is right mouse button:
            remove 1 from {config.tasksPerPlayer}

        if {config.tasksPerPlayer} < 1:
            set {config.tasksPerPlayer} to 1
        if {config.tasksPerPlayer} > 24:
            set {config.tasksPerPlayer} to 24

        openConfig(player)
        stop


    
    if clicked slot is 18:

        if click type is left mouse button:
            add 0.25 to {config.playerSpeed}
        else if click type is right mouse button:
            remove 0.25 from {config.playerSpeed}

        if {config.playerSpeed} < 0.5:
            set {config.playerSpeed} to 0.5
        if {config.playerSpeed} > 3:
            set {config.playerSpeed} to 3
        
        loop all players:
            updateSpeed(loop-player)
        openConfig(player)
        stop


    
    if clicked slot is 8:

        add 1 to {config.taskBarMode}

        if {config.taskBarMode} > 2:
            set {config.taskBarMode} to 0

        openConfig(player)
        stop

    
    if clicked slot is 17:

        if {config.anonymousVotes} is true:
            set {config.anonymousVotes} to false
        else:
            set {config.anonymousVotes} to true

        openConfig(player)
        stop

    
    
    if clicked slot is 26:

        if {config.confirmEjects} is true:
            set {config.confirmEjects} to false
        else:
            set {config.confirmEjects} to true

        openConfig(player)
        stop

    
    if clicked slot is 35:

        if {config.impostorsKnowEachOther} is true:
            set {config.impostorsKnowEachOther} to false
        else:
            set {config.impostorsKnowEachOther} to true

        openConfig(player)
        stop


    
    if clicked slot is 4:

        if click type is left mouse button:
            add 5 to {config.doorCooldown}
        else:
            remove 5 from {config.doorCooldown}

        if {config.doorCooldown} < 5:
            set {config.doorCooldown} to 5
        if {config.doorCooldown} > 60:
            set {config.doorCooldown} to 60

        openConfig(player)
        stop

    if clicked slot is 13:

        if click type is left mouse button:
            add 5 to {config.sabotageCooldown}
        else:
            remove 5 from {config.sabotageCooldown}

        if {config.sabotageCooldown} < 10:
            set {config.sabotageCooldown} to 10
        if {config.sabotageCooldown} > 90:
            set {config.sabotageCooldown} to 90

        openConfig(player)
        stop

    if clicked slot is 22:

        if click type is left mouse button:
            add 5 to {config.initialSabotageCooldown}
        else:
            remove 5 from {config.initialSabotageCooldown}

        if {config.initialSabotageCooldown} < 0:
            set {config.initialSabotageCooldown} to 0
        if {config.initialSabotageCooldown} > 60:
            set {config.initialSabotageCooldown} to 60

        openConfig(player)
        stop

    if clicked slot is 31:

        if click type is left mouse button:
            add 5 to {config.postMeetingSabotageCooldown}
        else:
            remove 5 from {config.postMeetingSabotageCooldown}

        if {config.postMeetingSabotageCooldown} < 0:
            set {config.postMeetingSabotageCooldown} to 0
        if {config.postMeetingSabotageCooldown} > 60:
            set {config.postMeetingSabotageCooldown} to 60

        openConfig(player)
        stop

    if clicked slot is 48:

        if click type is left mouse button:
            add 5 to {config.reactorCollapseTime}
        else:
            remove 5 from {config.reactorCollapseTime}

        if {config.reactorCollapseTime} < 15:
            set {config.reactorCollapseTime} to 15
        if {config.reactorCollapseTime} > 120:
            set {config.reactorCollapseTime} to 120

        openConfig(player)
        stop

    if clicked slot is 49:

        if click type is left mouse button:
            add 5 to {config.labFireTime}
        else:
            remove 5 from {config.labFireTime}

        if {config.labFireTime} < 15:
            set {config.labFireTime} to 15
        if {config.labFireTime} > 120:
            set {config.labFireTime} to 120

        openConfig(player)
        stop

    if clicked slot is 50:

        if click type is left mouse button:
            add 1 to {config.doorDuration}
        else:
            remove 1 from {config.doorDuration}

        if {config.doorDuration} < 1:
            set {config.doorDuration} to 1
        if {config.doorDuration} > 30:
            set {config.doorDuration} to 30

        openConfig(player)
        stop


    
    if clicked slot is 6:

        if click type is left mouse button:
            add 5 to {config.initialMeetingCooldown}
        else:
            remove 5 from {config.initialMeetingCooldown}

        if {config.initialMeetingCooldown} < 0:
            set {config.initialMeetingCooldown} to 0
        if {config.initialMeetingCooldown} > 90:
            set {config.initialMeetingCooldown} to 90

        openConfig(player)
        stop

    if clicked slot is 15:

        if click type is left mouse button:
            add 5 to {config.postMeetingCooldown}
        else:
            remove 5 from {config.postMeetingCooldown}

        if {config.postMeetingCooldown} < 0:
            set {config.postMeetingCooldown} to 0
        if {config.postMeetingCooldown} > 120:
            set {config.postMeetingCooldown} to 120

        openConfig(player)
        stop

    if clicked slot is 24:

        if click type is left mouse button:
            add 1 to {config.meetingLimit}
        else if click type is right mouse button:
            remove 1 from {config.meetingLimit}

        if {config.meetingLimit} < 0:
            set {config.meetingLimit} to 0
        if {config.meetingLimit} > 9:
            set {config.meetingLimit} to 9

        openConfig(player)
        stop

    
    
    if clicked slot is 2:

        if click type is left mouse button:
            add 5 to {config.initialKillCooldown}
        else:
            remove 5 from {config.initialKillCooldown}

        if {config.initialKillCooldown} < 0:
            set {config.initialKillCooldown} to 0
        if {config.initialKillCooldown} > 60:
            set {config.initialKillCooldown} to 60

        openConfig(player)
        stop

    if clicked slot is 11:

        if click type is left mouse button:
            add 5 to {config.killCooldown}
        else:
            remove 5 from {config.killCooldown}

        if {config.killCooldown} < 5:
            set {config.killCooldown} to 5
        if {config.killCooldown} > 90:
            set {config.killCooldown} to 90

        openConfig(player)
        stop

    if clicked slot is 20:

        if click type is left mouse button:
            add 5 to {config.postMeetingKillCooldown}
        else:
            remove 5 from {config.postMeetingKillCooldown}

        if {config.postMeetingKillCooldown} < 0:
            set {config.postMeetingKillCooldown} to 0
        if {config.postMeetingKillCooldown} > 60:
            set {config.postMeetingKillCooldown} to 60

        openConfig(player)
        stop


    
    if clicked slot is 29:

        if click type is left mouse button:
            add 0.5 to {config.killRange}
        else:
            remove 0.5 from {config.killRange}

        if {config.killRange} < 1:
            set {config.killRange} to 1

        if {config.killRange} > 4:
            set {config.killRange} to 4

        openConfig(player)
        stop


    
    if clicked slot is 53:
        close player's inventory
        execute console command "/start"


on right click:
    if player's tool is compass named "&cConfigurações":
        cancel event
        execute player command "config"
        stop

function updateSpeed(p: player):
    set walk speed of {_p} to 0.2*{config.playerSpeed}