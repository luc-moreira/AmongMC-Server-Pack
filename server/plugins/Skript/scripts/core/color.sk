function updateArmor(p: player):

    set {_color} to {color.%uuid of {_p}%}

    if {_color} is not set:
        set {_color} to "white"

    if {_color} is "white":
        set {_rgb} to rgb(249, 255, 254)
    else if {_color} is "orange":
        set {_rgb} to rgb(249, 128, 29)
    else if {_color} is "magenta":
        set {_rgb} to rgb(199, 78, 189)
    else if {_color} is "light_blue":
        set {_rgb} to rgb(58, 179, 218)
    else if {_color} is "yellow":
        set {_rgb} to rgb(254, 216, 61)
    else if {_color} is "lime":
        set {_rgb} to rgb(128, 199, 31)
    else if {_color} is "pink":
        set {_rgb} to rgb(243, 139, 170)
    else if {_color} is "gray":
        set {_rgb} to rgb(71, 79, 82)
    else if {_color} is "light_gray":
        set {_rgb} to rgb(157, 157, 151)
    else if {_color} is "cyan":
        set {_rgb} to rgb(22, 156, 156)
    else if {_color} is "purple":
        set {_rgb} to rgb(137, 50, 184)
    else if {_color} is "blue":
        set {_rgb} to rgb(60, 68, 170)
    else if {_color} is "brown":
        set {_rgb} to rgb(131, 84, 50)
    else if {_color} is "green":
        set {_rgb} to rgb(94, 124, 22)
    else if {_color} is "red":
        set {_rgb} to rgb(176, 46, 38)
    else if {_color} is "black":
        set {_rgb} to rgb(29, 29, 33)

    set {_helmet} to leather helmet
    dye {_helmet} {_rgb}

    if {hat.%uuid of {_p}%} is "none":
        set {_helmet} to air
    else if {hat.%uuid of {_p}%} is set:
        set {_helmet} to {hat.%uuid of {_p}%}

    set {_chestplate} to leather chestplate
    dye {_chestplate} {_rgb}

    set {_leggings} to leather leggings
    dye {_leggings} {_rgb}

    set {_boots} to leather boots
    dye {_boots} {_rgb}

    equip {_p} with {_helmet}, {_chestplate}, {_leggings}, {_boots}

command /cor:
    aliases: color
    trigger:
        if {game.state} is not "waiting":
            send getTr("color.cannotChange") to player
            stop

        set {_inv} to chest inventory with 2 rows named getTr("color.chooseColor")

        if colorTaken("white", player) is true:
            set slot 0 of {_inv} to white stained glass named getTr("color.white")
        else:
            set slot 0 of {_inv} to white wool named getTr("color.white")

        if colorTaken("orange", player) is true:
            set slot 1 of {_inv} to orange stained glass named getTr("color.orange")
        else:
            set slot 1 of {_inv} to orange wool named getTr("color.orange")

        if colorTaken("magenta", player) is true:
            set slot 2 of {_inv} to magenta stained glass named getTr("color.magenta")
        else:
            set slot 2 of {_inv} to magenta wool named getTr("color.magenta")

        if colorTaken("light_blue", player) is true:
            set slot 3 of {_inv} to light blue stained glass named getTr("color.lightBlue")
        else:
            set slot 3 of {_inv} to light blue wool named getTr("color.lightBlue")

        if colorTaken("yellow", player) is true:
            set slot 4 of {_inv} to yellow stained glass named getTr("color.yellow")
        else:
            set slot 4 of {_inv} to yellow wool named getTr("color.yellow")

        if colorTaken("lime", player) is true:
            set slot 5 of {_inv} to lime stained glass named getTr("color.lime")
        else:
            set slot 5 of {_inv} to lime wool named getTr("color.lime")

        if colorTaken("pink", player) is true:
            set slot 6 of {_inv} to pink stained glass named getTr("color.pink")
        else:
            set slot 6 of {_inv} to pink wool named getTr("color.pink")

        if colorTaken("gray", player) is true:
            set slot 7 of {_inv} to gray stained glass named getTr("color.gray")
        else:
            set slot 7 of {_inv} to gray wool named getTr("color.gray")

        if colorTaken("light_gray", player) is true:
            set slot 8 of {_inv} to light gray stained glass named getTr("color.lightGray")
        else:
            set slot 8 of {_inv} to light gray wool named getTr("color.lightGray")

        if colorTaken("cyan", player) is true:
            set slot 9 of {_inv} to cyan stained glass named getTr("color.cyan")
        else:
            set slot 9 of {_inv} to cyan wool named getTr("color.cyan")

        if colorTaken("purple", player) is true:
            set slot 10 of {_inv} to purple stained glass named getTr("color.purple")
        else:
            set slot 10 of {_inv} to purple wool named getTr("color.purple")

        if colorTaken("blue", player) is true:
            set slot 11 of {_inv} to blue stained glass named getTr("color.blue")
        else:
            set slot 11 of {_inv} to blue wool named getTr("color.blue")

        if colorTaken("brown", player) is true:
            set slot 12 of {_inv} to brown stained glass named getTr("color.brown")
        else:
            set slot 12 of {_inv} to brown wool named getTr("color.brown")

        if colorTaken("green", player) is true:
            set slot 13 of {_inv} to green stained glass named getTr("color.green")
        else:
            set slot 13 of {_inv} to green wool named getTr("color.green")

        if colorTaken("red", player) is true:
            set slot 14 of {_inv} to red stained glass named getTr("color.red")
        else:
            set slot 14 of {_inv} to red wool named getTr("color.red")

        if colorTaken("black", player) is true:
            set slot 15 of {_inv} to black stained glass named getTr("color.black")
        else:
            set slot 15 of {_inv} to black wool named getTr("color.black")

        open {_inv} to player

on inventory click:

    if holder of event-inventory is set:
        stop

    if name of event-inventory != getTr("color.chooseColor"):
        stop

    cancel event

    if clicked slot < 0:
        stop

    if clicked slot > 15:
        stop

    if clicked slot = 0:
        set {_color} to "white"
    else if clicked slot = 1:
        set {_color} to "orange"
    else if clicked slot = 2:
        set {_color} to "magenta"
    else if clicked slot = 3:
        set {_color} to "light_blue"
    else if clicked slot = 4:
        set {_color} to "yellow"
    else if clicked slot = 5:
        set {_color} to "lime"
    else if clicked slot = 6:
        set {_color} to "pink"
    else if clicked slot = 7:
        set {_color} to "gray"
    else if clicked slot = 8:
        set {_color} to "light_gray"
    else if clicked slot = 9:
        set {_color} to "cyan"
    else if clicked slot = 10:
        set {_color} to "purple"
    else if clicked slot = 11:
        set {_color} to "blue"
    else if clicked slot = 12:
        set {_color} to "brown"
    else if clicked slot = 13:
        set {_color} to "green"
    else if clicked slot = 14:
        set {_color} to "red"
    else if clicked slot = 15:
        set {_color} to "black"

    if {color.%uuid of player%} is {_color}:
        send getTr("color.alreadyUsing") to player
        stop

    loop all players:
        if loop-player is not player:
            if {color.%uuid of loop-player%} is {_color}:
                send getTr("color.alreadyUsed") to player
                stop

    set {color.%uuid of player%} to {_color}

    close player's inventory
    updateArmor(player)
    set {_colorname} to getTr("color.%{_color}%")
    send getTr("color.assigned", "%{_colorname}%") to player

function colorTaken(color: text, viewer: player) :: boolean:

    loop all players:
        if {color.%uuid of loop-player%} is {_color}:
            return true

    return false

function chatColor(p: player) :: text:

    set {_color} to {color.%uuid of {_p}%}

    if {_color} is "white":
        return "&f"
    else if {_color} is "orange":
        return "&6"
    else if {_color} is "magenta":
        return "&d"
    else if {_color} is "light_blue":
        return "&b"
    else if {_color} is "yellow":
        return "&e"
    else if {_color} is "lime":
        return "&a"
    else if {_color} is "pink":
        return "&d"
    else if {_color} is "gray":
        return "&8"
    else if {_color} is "light_gray":
        return "&7"
    else if {_color} is "cyan":
        return "&3"
    else if {_color} is "purple":
        return "&5"
    else if {_color} is "blue":
        return "&9"
    else if {_color} is "brown":
        return "&6"
    else if {_color} is "green":
        return "&2"
    else if {_color} is "red":
        return "&c"
    else if {_color} is "black":
        return "&0"

    return "&f"

on right click:

    if player's tool is nether star named getTr("color.chooseColor"):
        cancel event
        execute player command "cor"

on join:
    set {_ok} to false

    if {color.%uuid of player%} is set:

        set {_myColor} to {color.%uuid of player%}
        set {_taken} to false

        loop all players:
            if loop-player is not player:
                if {color.%uuid of loop-player%} is {_myColor}:
                    set {_taken} to true

        if {_taken} is false:
            set {_ok} to true

    if {_ok} is false:

        loop "white", "orange", "magenta", "light_blue", "yellow", "lime", "pink", "gray", "light_gray", "cyan", "purple", "blue", "brown", "green", "red", "black":

            set {_taken} to false

            loop all players:
                if loop-player is not player:
                    if {color.%uuid of loop-player%} is loop-value-1:
                        set {_taken} to true

            if {_taken} is false:

                set {color.%uuid of player%} to loop-value

                send getTr("color.noColor") to player
                send getTr("color.newColor", "%chatColor(player)%%loop-value%") to player
                send getTr("color.howToChange") to player
                stop


    updateArmor(player)