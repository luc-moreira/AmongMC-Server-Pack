on load:
    clear {achievement::availableHats::*}
    add "panda spawn egg" to {achievement::availableHats::*}
    add "allay spawn egg" to {achievement::availableHats::*}
    add "cat spawn egg" to {achievement::availableHats::*}
    add "goat spawn egg" to {achievement::availableHats::*}
    add "chicken spawn egg" to {achievement::availableHats::*}
    add "parrot spawn egg" to {achievement::availableHats::*}
    add "bee spawn egg" to {achievement::availableHats::*}
    add "axolotl spawn egg" to {achievement::availableHats::*}
    add "bat spawn egg" to {achievement::availableHats::*}
    add "donkey spawn egg" to {achievement::availableHats::*}
    add "creeper spawn egg" to {achievement::availableHats::*}
    add "amethyst cluster" to {achievement::availableHats::*}
    add "ender pearl" to {achievement::availableHats::*}
    add "diamond" to {achievement::availableHats::*}
    add "redstone torch" to {achievement::availableHats::*}
    add "carrot" to {achievement::availableHats::*}
    add "honeycomb" to {achievement::availableHats::*}
    add "cookie" to {achievement::availableHats::*}
    add "cake" to {achievement::availableHats::*}
    add "pufferfish" to {achievement::availableHats::*}
    add "tropical fish" to {achievement::availableHats::*}
    add "red mushroom" to {achievement::availableHats::*}
    add "torchflower" to {achievement::availableHats::*}
    add "mangrove propagule" to {achievement::availableHats::*}
    add "cherry sapling" to {achievement::availableHats::*}
    add "nautilus shell" to {achievement::availableHats::*}
    add "bell" to {achievement::availableHats::*}

    initAchievements()


command /hat:
    aliases: chapeu
    trigger:
        openHatMenu(player)

function openHatMenu(p: player):

    set {_inv} to chest inventory with 4 rows named getTr("hat.chooseHat")

    set {_color} to {color.%uuid of {_p}%}

    if {_color} is not set:
        set {_color} to "white"

    if {_color} is "white":
        set {_rgb} to rgb(249, 255, 254)
    else if {_color} is "orange":
        set {_rgb} to rgb(249, 128, 29)
    else if {_color} is "magenta":
        set {_rgb} to rgb(199, 78, 189)
    else if {_color} is "light_blue":
        set {_rgb} to rgb(58, 179, 218)
    else if {_color} is "yellow":
        set {_rgb} to rgb(254, 216, 61)
    else if {_color} is "lime":
        set {_rgb} to rgb(128, 199, 31)
    else if {_color} is "pink":
        set {_rgb} to rgb(243, 139, 170)
    else if {_color} is "gray":
        set {_rgb} to rgb(71, 79, 82)
    else if {_color} is "light_gray":
        set {_rgb} to rgb(157, 157, 151)
    else if {_color} is "cyan":
        set {_rgb} to rgb(22, 156, 156)
    else if {_color} is "purple":
        set {_rgb} to rgb(137, 50, 184)
    else if {_color} is "blue":
        set {_rgb} to rgb(60, 68, 170)
    else if {_color} is "brown":
        set {_rgb} to rgb(131, 84, 50)
    else if {_color} is "green":
        set {_rgb} to rgb(94, 124, 22)
    else if {_color} is "red":
        set {_rgb} to rgb(176, 46, 38)
    else if {_color} is "black":
        set {_rgb} to rgb(29, 29, 33)

    set {_helmet} to leather helmet
    dye {_helmet} {_rgb}

    set slot 0 of {_inv} to {_helmet} named getTr("hat.helmet")
    set slot 1 of {_inv} to structure_void named getTr("hat.none")

    set {_hatList::*} to ""
    add "9,panda spawn egg,hat.panda" to {_hatList::*}
    add "10,allay spawn egg,hat.allay" to {_hatList::*}
    add "11,cat spawn egg,hat.cat" to {_hatList::*}
    add "12,goat spawn egg,hat.goat" to {_hatList::*}
    add "13,chicken spawn egg,hat.chicken" to {_hatList::*}
    add "14,parrot spawn egg,hat.parrot" to {_hatList::*}
    add "15,bee spawn egg,hat.bee" to {_hatList::*}
    add "16,axolotl spawn egg,hat.axolotl" to {_hatList::*}
    add "17,bat spawn egg,hat.bat" to {_hatList::*}
    add "18,donkey spawn egg,hat.donkey" to {_hatList::*}
    add "19,creeper spawn egg,hat.creeper" to {_hatList::*}
    add "20,amethyst cluster,hat.amethyst" to {_hatList::*}
    add "21,ender pearl,hat.enderPearl" to {_hatList::*}
    add "22,diamond,hat.diamond" to {_hatList::*}
    add "23,redstone torch,hat.redstoneTorch" to {_hatList::*}
    add "24,carrot,hat.carrot" to {_hatList::*}
    add "25,honeycomb,hat.honeycomb" to {_hatList::*}
    add "26,cookie,hat.cookie" to {_hatList::*}
    add "27,cake,hat.cake" to {_hatList::*}
    add "28,pufferfish,hat.pufferfish" to {_hatList::*}
    add "29,tropical fish,hat.tropicalFish" to {_hatList::*}
    add "30,red mushroom,hat.redMushroom" to {_hatList::*}
    add "31,torchflower,hat.torchflower" to {_hatList::*}
    add "32,mangrove propagule,hat.propagule" to {_hatList::*}
    add "33,cherry sapling,hat.cherrySapling" to {_hatList::*}
    add "34,nautilus shell,hat.nautilusShell" to {_hatList::*}
    add "35,bell,hat.bell" to {_hatList::*}

    set {_uuid} to uuid of {_p}
    set {_unlocked::*} to {achievement::unlockedHats::%{_uuid}%::*}
    if {_unlocked::*} is not set:
        clear {_unlocked::*}

    loop {_hatList::*}:
        set {_data::*} to loop-value split at ","
        set {_slot} to {_data::1} parsed as number
        set {_item} to {_data::2} parsed as itemtype
        set {_trKey} to {_data::3}

        set {_hatName} to getTr("%{_trKey}%")

        set {_isUnlocked} to false
        set {_itemName} to "%{_item}%"
        loop {_unlocked::*}:
            if loop-value-2 = {_itemName}:
                set {_isUnlocked} to true

        if {_isUnlocked} is true:
            set slot {_slot} of {_inv} to {_item} named "&a%{_hatName}%"
        else:
            set {_barrier} to barrier named "&c%{_hatName}% &7(Locked)"
            set slot {_slot} of {_inv} to {_barrier}

    open {_inv} to {_p}

on inventory click:

    if holder of event-inventory is set:
        stop

    if name of event-inventory is not getTr("hat.chooseHat"):
        stop
    cancel event

    set {_slot} to index of clicked slot

    if {_slot} is between 9 and 35:
        set {_uuid} to uuid of player
        set {_unlocked::*} to {achievement::unlockedHats::%{_uuid}%::*}
        if {_unlocked::*} is not set:
            clear {_unlocked::*}

        set {_hatItem} to ""
        if {_slot} = 9:
            set {_hatItem} to "panda spawn egg"
        else if {_slot} = 10:
            set {_hatItem} to "allay spawn egg"
        else if {_slot} = 11:
            set {_hatItem} to "cat spawn egg"
        else if {_slot} = 12:
            set {_hatItem} to "goat spawn egg"
        else if {_slot} = 13:
            set {_hatItem} to "chicken spawn egg"
        else if {_slot} = 14:
            set {_hatItem} to "parrot spawn egg"
        else if {_slot} = 15:
            set {_hatItem} to "bee spawn egg"
        else if {_slot} = 16:
            set {_hatItem} to "axolotl spawn egg"
        else if {_slot} = 17:
            set {_hatItem} to "bat spawn egg"
        else if {_slot} = 18:
            set {_hatItem} to "donkey spawn egg"
        else if {_slot} = 19:
            set {_hatItem} to "creeper spawn egg"
        else if {_slot} = 20:
            set {_hatItem} to "amethyst cluster"
        else if {_slot} = 21:
            set {_hatItem} to "ender pearl"
        else if {_slot} = 22:
            set {_hatItem} to "diamond"
        else if {_slot} = 23:
            set {_hatItem} to "redstone torch"
        else if {_slot} = 24:
            set {_hatItem} to "carrot"
        else if {_slot} = 25:
            set {_hatItem} to "honeycomb"
        else if {_slot} = 26:
            set {_hatItem} to "cookie"
        else if {_slot} = 27:
            set {_hatItem} to "cake"
        else if {_slot} = 28:
            set {_hatItem} to "pufferfish"
        else if {_slot} = 29:
            set {_hatItem} to "tropical fish"
        else if {_slot} = 30:
            set {_hatItem} to "red mushroom"
        else if {_slot} = 31:
            set {_hatItem} to "torchflower"
        else if {_slot} = 32:
            set {_hatItem} to "mangrove propagule"
        else if {_slot} = 33:
            set {_hatItem} to "cherry sapling"
        else if {_slot} = 34:
            set {_hatItem} to "nautilus shell"
        else if {_slot} = 35:
            set {_hatItem} to "bell"

        set {_isUnlocked} to false
        loop {_unlocked::*}:
            if loop-value = {_hatItem}:
                set {_isUnlocked} to true

        if {_isUnlocked} is not true:
            send "&cThis hat is locked! Level up to unlock it." to player
            stop

    if {_slot} = 0:
        delete {hat.%uuid of player%}
        set {_hatName} to getTr("hat.helmet")
        updateArmor(player)
        send getTr("hat.changed", "%{_hatName}%") to player
        close player's inventory
        stop

    if {_slot} = 1:
        set {hat.%uuid of player%} to "none"
        set {_hatName} to getTr("hat.none")
        updateArmor(player)
        send getTr("hat.changed", "%{_hatName}%") to player
        close player's inventory
        stop

    if {_slot} = 9:
        set {hat.%uuid of player%} to panda spawn egg
        set {_hatName} to getTr("hat.panda")
    else if {_slot} = 10:
        set {hat.%uuid of player%} to allay spawn egg
        set {_hatName} to getTr("hat.allay")
    else if {_slot} = 11:
        set {hat.%uuid of player%} to cat spawn egg
        set {_hatName} to getTr("hat.cat")
    else if {_slot} = 12:
        set {hat.%uuid of player%} to goat spawn egg
        set {_hatName} to getTr("hat.goat")
    else if {_slot} = 13:
        set {hat.%uuid of player%} to chicken spawn egg
        set {_hatName} to getTr("hat.chicken")
    else if {_slot} = 14:
        set {hat.%uuid of player%} to parrot spawn egg
        set {_hatName} to getTr("hat.parrot")
    else if {_slot} = 15:
        set {hat.%uuid of player%} to bee spawn egg
        set {_hatName} to getTr("hat.bee")
    else if {_slot} = 16:
        set {hat.%uuid of player%} to axolotl spawn egg
        set {_hatName} to getTr("hat.axolotl")
    else if {_slot} = 17:
        set {hat.%uuid of player%} to bat spawn egg
        set {_hatName} to getTr("hat.bat")
    else if {_slot} = 18:
        set {hat.%uuid of player%} to donkey spawn egg
        set {_hatName} to getTr("hat.donkey")
    else if {_slot} = 19:
        set {hat.%uuid of player%} to creeper spawn egg
        set {_hatName} to getTr("hat.creeper")
    else if {_slot} = 20:
        set {hat.%uuid of player%} to amethyst cluster
        set {_hatName} to getTr("hat.amethyst")
    else if {_slot} = 21:
        set {hat.%uuid of player%} to ender pearl item
        set {_hatName} to getTr("hat.enderPearl")
    else if {_slot} = 22:
        set {hat.%uuid of player%} to diamond
        set {_hatName} to getTr("hat.diamond")
    else if {_slot} = 23:
        set {hat.%uuid of player%} to redstone torch
        set {_hatName} to getTr("hat.redstoneTorch")
    else if {_slot} = 24:
        set {hat.%uuid of player%} to carrot
        set {_hatName} to getTr("hat.carrot")
    else if {_slot} = 25:
        set {hat.%uuid of player%} to honeycomb
        set {_hatName} to getTr("hat.honeycomb")
    else if {_slot} = 26:
        set {hat.%uuid of player%} to cookie
        set {_hatName} to getTr("hat.cookie")
    else if {_slot} = 27:
        set {hat.%uuid of player%} to cake
        set {_hatName} to getTr("hat.cake")
    else if {_slot} = 28:
        set {hat.%uuid of player%} to pufferfish
        set {_hatName} to getTr("hat.pufferfish")
    else if {_slot} = 29:
        set {hat.%uuid of player%} to tropical fish
        set {_hatName} to getTr("hat.tropicalFish")
    else if {_slot} = 30:
        set {hat.%uuid of player%} to red mushroom
        set {_hatName} to getTr("hat.redMushroom")
    else if {_slot} = 31:
        set {hat.%uuid of player%} to torchflower
        set {_hatName} to getTr("hat.torchflower")
    else if {_slot} = 32:
        set {hat.%uuid of player%} to mangrove propagule
        set {_hatName} to getTr("hat.propagule")
    else if {_slot} = 33:
        set {hat.%uuid of player%} to cherry sapling
        set {_hatName} to getTr("hat.cherrySapling")
    else if {_slot} = 34:
        set {hat.%uuid of player%} to nautilus shell
        set {_hatName} to getTr("hat.nautilusShell")
    else if {_slot} = 35:
        set {hat.%uuid of player%} to bell
        set {_hatName} to getTr("hat.bell")
    else:
        stop

    updateArmor(player)
    send getTr("hat.changed", "%{_hatName}%") to player
    close player's inventory


on right click:
    if player's tool is leather helmet named getTr("hat.chooseHat"):
        cancel event
        execute player command "hat"