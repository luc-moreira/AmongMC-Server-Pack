function tune_radio(p: player, step: number):

    if {_p} is from floodgate:
        send getTr("task.bedrockDownload") to {_p}
        wait 1 second
        download({_p}, {_step}, "tune_radio")
        stop


    set {_inv} to chest inventory with 6 rows named "&8Sintonizar Rádio"

    loop 54 times:
        set slot (loop-number - 1) of {_inv} to gray stained glass pane named " "

    loop 9 times:
        set slot (loop-number - 1) of {_inv} to light gray stained glass pane named " "

    loop 9 times:
        set slot (17 + loop-number) of {_inv} to light gray stained glass pane named " "

    loop 9 times:
        set slot (35 + loop-number) of {_inv} to light gray stained glass pane named " "

    set slot 13 of {_inv} to lever named "&eTravar frequência"
    set slot 31 of {_inv} to lever named "&eTravar frequência"
    set slot 49 of {_inv} to lever named "&eTravar frequência"

    loop 3 times:

        set {radio.target.%uuid of {_p}%.%loop-number%} to random integer between 0 and 8
        set {radio.pos.%uuid of {_p}%.%loop-number%} to random integer between 0 and 8
        set {radio.dir.%uuid of {_p}%.%loop-number%} to 1
        set {radio.done.%uuid of {_p}%.%loop-number%} to false
        set {radio.speed.%uuid of {_p}%.%loop-number%} to "%random integer between 6 and 8% ticks" parsed as timespan

    set {radio.running.%uuid of {_p}%} to true
    set {radio.step.%uuid of {_p}%} to {_step}

    add 1 to {radio.session.%uuid of {_p}%}

    open {_inv} to {_p}

    wait 1 tick

    drawRadio({_p})

    moveRadio({_p}, 1, {radio.session.%uuid of {_p}%})
    moveRadio({_p}, 2, {radio.session.%uuid of {_p}%})
    moveRadio({_p}, 3, {radio.session.%uuid of {_p}%})


function moveRadio(p: player, radio: number, session: number):

    if {radio.running.%uuid of {_p}%} is not true:
        stop

    if {_session} is not {radio.session.%uuid of {_p}%}:
        stop

    if name of {_p}'s current inventory is not "&8Sintonizar Rádio":
        stop

    if {radio.done.%uuid of {_p}%.%{_radio}%} is true:
        stop

    wait {radio.speed.%uuid of {_p}%.%{_radio}%}

    if {radio.running.%uuid of {_p}%} is not true:
        stop

    if {_session} is not {radio.session.%uuid of {_p}%}:
        stop

    add {radio.dir.%uuid of {_p}%.%{_radio}%} to {radio.pos.%uuid of {_p}%.%{_radio}%}

    if {radio.pos.%uuid of {_p}%.%{_radio}%} >= 8:
        set {radio.pos.%uuid of {_p}%.%{_radio}%} to 8
        set {radio.dir.%uuid of {_p}%.%{_radio}%} to -1
    else if {radio.pos.%uuid of {_p}%.%{_radio}%} <= 0:
        set {radio.pos.%uuid of {_p}%.%{_radio}%} to 0
        set {radio.dir.%uuid of {_p}%.%{_radio}%} to 1

    drawRadio({_p})

    moveRadio({_p}, {_radio}, {_session})


function drawRadio(p: player):

    if name of {_p}'s current inventory is not "&8Sintonizar Rádio":
        stop

    set {_inv} to {_p}'s current inventory

    loop 9 times:
        set slot (loop-number - 1) of {_inv} to light gray stained glass pane named " "
        set slot (17 + loop-number) of {_inv} to light gray stained glass pane named " "
        set slot (35 + loop-number) of {_inv} to light gray stained glass pane named " "


    if {radio.done.%uuid of {_p}%.1} is true:
        set {_pos} to {radio.target.%uuid of {_p}%.1}
    else:
        set {_pos} to {radio.pos.%uuid of {_p}%.1}

    loop ({_pos} + 1) times:
        set slot (loop-number - 1) of {_inv} to blue concrete named "&9Sinal"

    if {radio.done.%uuid of {_p}%.1} is true:
        set slot {radio.target.%uuid of {_p}%.1} of {_inv} to lime stained glass pane named "&aSintonizado"
    else:
        if {_pos} is {radio.target.%uuid of {_p}%.1}:
            set slot {radio.target.%uuid of {_p}%.1} of {_inv} to lime stained glass pane named "&aFrequência"
        else:
            set slot {radio.target.%uuid of {_p}%.1} of {_inv} to red stained glass pane named "&cFrequência"

    if {radio.done.%uuid of {_p}%.2} is true:
        set {_pos} to {radio.target.%uuid of {_p}%.2}
    else:
        set {_pos} to {radio.pos.%uuid of {_p}%.2}

    loop ({_pos} + 1) times:
        set slot (17 + loop-number) of {_inv} to yellow concrete named "&eSinal"

    if {radio.done.%uuid of {_p}%.2} is true:
        set slot (18 + {radio.target.%uuid of {_p}%.2}) of {_inv} to lime stained glass pane named "&aSintonizado"
    else:
        if {_pos} is {radio.target.%uuid of {_p}%.2}:
            set slot (18 + {radio.target.%uuid of {_p}%.2}) of {_inv} to lime stained glass pane named "&aFrequência"
        else:
            set slot (18 + {radio.target.%uuid of {_p}%.2}) of {_inv} to red stained glass pane named "&cFrequência"

    if {radio.done.%uuid of {_p}%.3} is true:
        set {_pos} to {radio.target.%uuid of {_p}%.3}
    else:
        set {_pos} to {radio.pos.%uuid of {_p}%.3}

    loop ({_pos} + 1) times:
        set slot (35 + loop-number) of {_inv} to red concrete named "&cSinal"

    if {radio.done.%uuid of {_p}%.3} is true:
        set slot (36 + {radio.target.%uuid of {_p}%.3}) of {_inv} to lime stained glass pane named "&aSintonizado"
    else:
        if {_pos} is {radio.target.%uuid of {_p}%.3}:
            set slot (36 + {radio.target.%uuid of {_p}%.3}) of {_inv} to lime stained glass pane named "&aFrequência"
        else:
            set slot (36 + {radio.target.%uuid of {_p}%.3}) of {_inv} to red stained glass pane named "&cFrequência"

    if {radio.done.%uuid of {_p}%.1} is true:
        set slot 13 of {_inv} to lime concrete named "&aSintonizado"

    if {radio.done.%uuid of {_p}%.2} is true:
        set slot 31 of {_inv} to lime concrete named "&aSintonizado"

    if {radio.done.%uuid of {_p}%.3} is true:
        set slot 49 of {_inv} to lime concrete named "&aSintonizado"

on inventory click:

    if holder of event-inventory is set:
        stop

    if name of event-inventory is not "&8Sintonizar Rádio":
        stop

    cancel event

    set {_row} to 0

    if clicked slot is 13:
        set {_row} to 1
    else if clicked slot is 31:
        set {_row} to 2
    else if clicked slot is 49:
        set {_row} to 3
    else:
        stop

    if {radio.done.%uuid of player%.%{_row}%} is true:
        stop


    if {radio.pos.%uuid of player%.%{_row}%} is {radio.target.%uuid of player%.%{_row}%}:

        set {radio.done.%uuid of player%.%{_row}%} to true

        play sound "minecraft:block.note_block.pling" with volume 1 and pitch 1.8 to player

        drawRadio(player)

        if {radio.done.%uuid of player%.1} is true:
            if {radio.done.%uuid of player%.2} is true:
                if {radio.done.%uuid of player%.3} is true:

                    set {radio.running.%uuid of player%} to false

                    wait 10 ticks

                    close player's inventory

                    advanceTaskStep(player, "tune_radio", {radio.step.%uuid of player%})

                    delete {radio.running.%uuid of player%}
                    delete {radio.step.%uuid of player%}
                    delete {radio.session.%uuid of player%}

                    loop 3 times:
                        delete {radio.pos.%uuid of player%.%loop-number%}
                        delete {radio.target.%uuid of player%.%loop-number%}
                        delete {radio.dir.%uuid of player%.%loop-number%}
                        delete {radio.speed.%uuid of player%.%loop-number%}
                        delete {radio.done.%uuid of player%.%loop-number%}

    else:

        set {radio.running.%uuid of player%} to false

        play sound "minecraft:block.note_block.bass" with volume 1 and pitch 0.6 to player

        close player's inventory

        tune_radio(player, 1)


on inventory close:

    if name of event-inventory is not "&8Sintonizar Rádio":
        stop

    set {radio.running.%uuid of player%} to false

    delete {radio.step.%uuid of player%}
    delete {radio.session.%uuid of player%}

    loop 3 times:
        delete {radio.pos.%uuid of player%.%loop-number%}
        delete {radio.target.%uuid of player%.%loop-number%}
        delete {radio.dir.%uuid of player%.%loop-number%}
        delete {radio.speed.%uuid of player%.%loop-number%}
        delete {radio.done.%uuid of player%.%loop-number%}